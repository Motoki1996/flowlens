{
  "name": "FlowLens",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "docker-compose.yml"
  ],
  "service": "workspace",
  "runServices": ["workspace", "db"],
  "workspaceFolder": "/workspaces/flowlens",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "forwardPorts": [4000, 8080, 55432],
  "portsAttributes": {
    "4000": { "label": "web" },
    "8080": { "label": "api" },
    "55432": { "label": "postgres" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "go.useLanguageServer": true,
        "go.toolsManagement.checkForUpdates": "off"
      }
    }
  }
}
