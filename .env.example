# =====================================================================
# FlowLens environment variables (example)
# Copy to .env and fill in real values. Never commit .env.
# =====================================================================

# ---- Shared ----------------------------------------------------------
# Public URL of the web app (used for CORS).
WEB_BASE_URL=http://localhost:3000

# ---- Go API ----------------------------------------------------------
API_PORT=8080
# App runtime environment: "development" or "production".
APP_ENV=development

# PostgreSQL connection string used by the API and migrations.
DATABASE_URL=postgres://flowlens:flowlens@localhost:55432/flowlens?sslmode=disable

# Session lifetime in hours.
SESSION_TTL_HOURS=168

# Base64-encoded 32-byte AES-256 key used to encrypt secrets at rest
# (GitLab access tokens, webhook secrets). Required. Generate one with:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# Public URL GitLab must be able to reach to deliver webhooks. Optional;
# when unset, webhook auto-registration is skipped and manual sync is used.
APP_PUBLIC_URL=

# Whether the in-process sync worker runs.
SYNC_WORKER_ENABLED=true
# How often the sync worker polls for outbox jobs.
SYNC_WORKER_POLL_INTERVAL=5s

# ---- Web (Next.js) ---------------------------------------------------
# Server-side base URL the web app uses to reach the API (inside Docker
# this is the compose service name; on the host it is localhost).
API_INTERNAL_URL=http://localhost:8080
# Base URL the browser uses to reach the API (for login/signup/logout requests).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
