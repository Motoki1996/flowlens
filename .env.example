# =====================================================================
# FlowLens environment variables (example)
# Copy to .env and fill in real values. Never commit .env.
# =====================================================================

# ---- Shared ----------------------------------------------------------
# Public URL of the web app (used for OAuth post-login redirect + CORS).
WEB_BASE_URL=http://localhost:3000
# Public URL of the Go API (used by the web app and OAuth callback).
API_BASE_URL=http://localhost:8080

# ---- Go API ----------------------------------------------------------
API_PORT=8080
# App runtime environment: "development" or "production".
APP_ENV=development

# PostgreSQL connection string used by the API and migrations.
DATABASE_URL=postgres://flowlens:flowlens@localhost:55432/flowlens?sslmode=disable

# GitHub OAuth App credentials.
# Create at: https://github.com/settings/developers
# Authorization callback URL must be: ${API_BASE_URL}/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=your_github_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_client_secret

# 32-byte key (base64 std-encoded) used by the local AES-GCM token cipher.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=change_me_generate_a_32_byte_base64_key

# Session lifetime in hours.
SESSION_TTL_HOURS=168

# ---- Web (Next.js) ---------------------------------------------------
# Server-side base URL the web app uses to reach the API (inside Docker
# this is the compose service name; on the host it is localhost).
API_INTERNAL_URL=http://localhost:8080
# Base URL the browser uses to reach the API (for redirects to /auth/github).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
