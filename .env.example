# =====================================================================
# FlowLens environment variables (example)
# Copy to .env and fill in real values. Never commit .env.
#
# Self-hosting with the prebuilt images? Only the four values marked
# [self-host] below need attention — see docs/self-hosting.md.
# =====================================================================

# ---- Self-hosting ----------------------------------------------------
# [self-host] Where this instance is reachable, from a browser and from
# GitLab (webhook delivery). Must be https:// for a real deployment.
APP_PUBLIC_URL=http://localhost:4000

# [self-host] Postgres password for the bundled database container.
POSTGRES_PASSWORD=change-me

# [self-host] Which release to run. Pin it — `latest` means an upgrade can
# happen at a moment you did not choose.
FLOWLENS_VERSION=latest

# Registry the images are pulled from. Point this at a mirror to install
# from a private registry on a closed network.
FLOWLENS_REGISTRY=ghcr.io/motoki1996

# Host interface and port the web app is published on.
FLOWLENS_BIND=0.0.0.0
FLOWLENS_PORT=4000

# Domain for the optional TLS overlay (compose.tls.yaml).
FLOWLENS_DOMAIN=

# ---- Shared ----------------------------------------------------------
# Public URL of the web app (used for CORS). With the default same-origin
# setup nothing is cross-origin, so this only matters if you serve the API
# from its own hostname.
WEB_BASE_URL=http://localhost:4000

# ---- Go API ----------------------------------------------------------
API_PORT=8080
# App runtime environment: "development" or "production". "production"
# marks the session cookie Secure, so it requires HTTPS.
APP_ENV=development

# PostgreSQL connection string used by the API and migrations.
DATABASE_URL=postgres://flowlens:flowlens@localhost:55432/flowlens?sslmode=disable

# Apply the embedded schema migrations at startup. Leave on unless
# migrations are run as their own deploy stage.
RUN_MIGRATIONS=true

# [self-host] Base64-encoded 32-byte AES-256 key used to encrypt secrets at
# rest (GitLab access tokens, webhook secrets). Required. Generate one with
# the API image itself, so no local toolchain is needed:
#   docker run --rm ghcr.io/motoki1996/flowlens-api:latest gen-key >> .env
# or, with openssl to hand:
#   echo "ENCRYPTION_KEY=$(openssl rand -base64 32)" >> .env
ENCRYPTION_KEY=

# Session lifetime in hours.
SESSION_TTL_HOURS=168

# Whether POST /auth/signup accepts new accounts. Turn this off once your
# accounts exist if the instance is reachable from a network you do not
# control. The very first account is always allowed, so a fresh instance
# can still be bootstrapped with this already set to false.
ALLOW_SIGNUP=true

# How many reverse proxies sit in front of the API and may be trusted to
# have appended to X-Forwarded-For. This is what the per-IP rate limiters
# key on, so an inaccurate value either shares one limit across every user
# or lets a client forge its own address. 0 trusts nothing; the bundled
# compose file uses 1 (the Next.js proxy), or 2 with the TLS overlay.
TRUSTED_PROXY_HOPS=0

# When set, GET /metrics requires this as a bearer token. The bundled
# compose file leaves it empty because it never publishes the API port.
METRICS_TOKEN=

# How the API verifies the TLS certificate of the GitLab instance it calls.
# Self-hosted GitLab CE is usually behind a private CA or a self-signed
# certificate, so verification is skipped by default — otherwise the
# handshake fails and the connection is only reported as "unreachable".
# To verify instead, point GITLAB_CA_CERT_FILE at the instance's CA (PEM);
# it takes precedence and turns verification back on.
GITLAB_TLS_INSECURE_SKIP_VERIFY=true
GITLAB_CA_CERT_FILE=

# Whether the in-process sync worker runs.
SYNC_WORKER_ENABLED=true
# How often the sync worker polls for outbox jobs.
SYNC_WORKER_POLL_INTERVAL=5s

# ---- Web (Next.js) ---------------------------------------------------
# Server-side base URL the web app uses to reach the API (inside Docker this
# is the compose service name; on the host it is localhost). Server
# Components read it at request time; the browser's proxied calls use it as
# the rewrite destination, which Next.js resolves at *build* time — so
# changing it for a prebuilt web image means rebuilding that image.
API_INTERNAL_URL=http://localhost:8080

# Base URL the browser uses to reach the API. Leave empty for the default
# same-origin setup, where the Next.js server proxies /api, /auth and
# /webhooks through to the API. Set it only to put the API on its own
# hostname — and note it is inlined into the client bundle at build time,
# so changing it means rebuilding the web image.
NEXT_PUBLIC_API_BASE_URL=
